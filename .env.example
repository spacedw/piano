# ── Supabase ─────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── App URL (used for OAuth redirects) ───────────────
VITE_APP_URL=https://pianoapp.uiai.dev

# ── LemonSqueezy Checkout URLs ───────────────────────
# 1. Create your product in LemonSqueezy dashboard
# 2. Create two variants: Monthly ($6) and Annual ($54)
# 3. Copy each variant's checkout URL here
#    Format: https://pianoapp.lemonsqueezy.com/buy/<variant-id>
VITE_LS_MONTHLY_URL=https://pianoapp.lemonsqueezy.com/buy/YOUR_MONTHLY_VARIANT_ID
VITE_LS_YEARLY_URL=https://pianoapp.lemonsqueezy.com/buy/YOUR_YEARLY_VARIANT_ID

# ── LemonSqueezy Webhook (Supabase Edge Function) ────
# Set this in Supabase Dashboard → Edge Functions → Secrets:
#   LEMONSQUEEZY_WEBHOOK_SECRET = <from LemonSqueezy dashboard>
#   SUPABASE_SERVICE_ROLE_KEY   = <from Supabase dashboard>
